; Energy minimization
; ⚠️ grompp runs with -maxwarn 0 here — no warnings tolerated. If EM grompp
;    aborts on a warning, fix the topology/MDP rather than raising maxwarn.
integrator              = steep
emtol                   = 1000.0
emstep                  = 0.01
nsteps                  = 50000
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.0
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
constraints             = none
define                  = -DPOSRES
