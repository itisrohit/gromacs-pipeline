; Production MD
integrator              = md
dt                      = 0.002
nstxout-compressed      = 25000
nstenergy               = 5000
nstlog                  = 5000
nstcalcenergy           = 500
nstcomm                 = 500
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4
cutoff-scheme           = Verlet
nstlist                 = 400
rlist                   = 1.0
verlet-buffer-tolerance = 0.002
coulombtype             = PME
rcoulomb                = 1.0
fourierspacing          = 0.12
pme_order               = 4
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres
mts                     = yes
tcoupl                  = v-rescale
tc-grps                 = Protein_DNA Water_Ions
tau_t                   = 0.1 0.1
ref_t                   = 300 300
pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau_p                   = 5.0
ref_p                   = 1.0
compressibility         = 4.5e-5
pbc                     = xyz
gen_vel                 = no
nsteps                  = -1
comm-mode               = Linear
comm-grps               = Protein_DNA Water_Ions
